{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/about/?$",
      "dest": "/api/about.php"
    },
    {
      "src": "^/service/?$",
      "dest": "/api/service.php"
    },
    {
      "src": "^/booking/?$",
      "dest": "/api/booking.php"
    },
    {
      "src": "^/events/?$",
      "dest": "/api/events.php"
    },
    {
      "src": "^/?$",
      "dest": "/api/index.php"
    }
  ]
}
