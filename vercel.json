{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/about.php",
      "dest": "/api/about.php"
    },
    {
      "src": "/service.php",
      "dest": "/api/service.php"
    },
    {
      "src": "/booking.php",
      "dest": "/api/booking.php"
    },
    {
      "src": "/index.php",
      "dest": "/api/index.php"
    }
  ]
}
